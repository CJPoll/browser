#! /usr/bin/env bash

set -o pipefail

# Run on the system Ruby (/usr/bin/ruby). Gems are vendored per-project via
# `bundle config path vendor/bundle`, so no root-owned system gem dir is touched.
# Prepend /usr/bin so the system ruby/bundle resolve even from a bare window-
# manager launch with a minimal PATH.
export PATH="/usr/bin:/home/cjpoll/bin/:$PATH"
# Run the checkout this script lives in, so a worktree launches its own branch
# rather than ~/dev/browser.
cd "$(dirname "$(readlink -f "$0")")"

# A GTK/WebKit crash says why on stderr, and the browser is normally launched
# from the window manager, where there is no terminal to say it to. Keep cores
# too: kernel.core_pattern is a bare "core", so one lands in this directory.
ulimit -c unlimited

# WebKit runs each page in its own web process guarded by a memory-pressure
# monitor that KILLS the process past an internal limit -- heavy apps like the
# Notion editor trip it and the tab dies with "exceeded-memory-limit". The
# proper API to raise that limit (WebKitMemoryPressureSettings) is not exposed
# in this version's Ruby bindings, so disable the monitor instead. Safe here:
# 48GB RAM, no cgroup cap, and the OS OOM killer remains the backstop.
export WEBKIT_DISABLE_MEMORY_PRESSURE_MONITOR=1

mkdir -p logs
echo $(ruby --version) > logs/ruby-version.log

echo "=== started $(date --iso-8601=seconds) ===" >> logs/browser.log
bundle exec ruby simple_browser.rb "${@}" 2>&1 | tee -a logs/browser.log
